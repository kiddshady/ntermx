{
  "name": "argon",
  "productName": "Argon",
  "version": "0.1.1",
  "description": "Argon — PowerShell con estética cyberpunk",
  "main": "src/main.js",
  "author": "francisco",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:nsis": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "postinstall": "node scripts/fix-node-pty-spectre.js && electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.umbrovex.argon",
    "productName": "Argon",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json",
      "!node_modules/**/{CHANGELOG.md,README.md,readme.md,*.d.ts,*.map,*.ts}",
      "!node_modules/**/{test,tests,__tests__,docs,doc,examples,example}/**"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Argon"
    },
    "portable": {
      "artifactName": "Argon-${version}-portable.exe"
    }
  },
  "keywords": [
    "terminal",
    "electron",
    "cyberpunk"
  ],
  "devDependencies": {
    "electron": "40.10.2",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0"
  }
}
